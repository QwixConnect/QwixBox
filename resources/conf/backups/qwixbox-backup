#!/usr/bin/env bash
# Managed by the QwixBox installer.
set -euo pipefail

umask 077
BACKUP_DIR="${BACKUP_DIR:-@BACKUP_DIR@}"
KEEP_DAYS="${BACKUP_KEEP_DAYS:-@BACKUP_KEEP_DAYS@}"
case "$KEEP_DAYS" in *[!0-9]*|"") echo "Invalid BACKUP_KEEP_DAYS" >&2; exit 1 ;; esac
STAMP="$(date +%Y%m%d-%H%M%S)"
DEST="$BACKUP_DIR/$STAMP"
install -d -m 0700 "$DEST"

fail=0

### Databases. --clean --if-exists makes each dump restorable over an existing database.
for db in kamailio qwixbox; do
  if ! exists="$(su - postgres -c "psql -v ON_ERROR_STOP=1 -tAc \"SELECT 1 FROM pg_database WHERE datname='$db'\"")"; then
    echo "FAILED to check database $db" >&2; fail=1
  elif [ "$exists" = 1 ]; then
    if su - postgres -c "pg_dump --clean --if-exists --format=custom '$db'" > "$DEST/$db.dump" 2>/dev/null; then
      echo "dumped $db ($(du -h "$DEST/$db.dump" | cut -f1))"
    else
      echo "FAILED to dump $db" >&2; fail=1
    fi
  fi
done

### Global objects (roles, and their passwords) are not in a per-database dump. Without this
### a restore comes back with no accounts able to log in.
su - postgres -c "pg_dumpall --globals-only" > "$DEST/globals.sql" 2>/dev/null || { echo "FAILED globals" >&2; fail=1; }

### Missing optional services are valid on split-role hosts; missing encryption config is not.
paths=()
for path in /etc/qwixbox /etc/kamailio /etc/rtpengine /etc/nginx/sites-available \
  /etc/nginx/conf.d /usr/local/freeswitch/conf /etc/opendkim/keys /etc/letsencrypt \
  /etc/systemd/system/freeswitch.service /etc/systemd/system/freeswitch.service.d \
  /etc/systemd/system/qwixbox-api.service /etc/nftables.conf /etc/fail2ban/jail.d; do
  [ ! -e "$path" ] || paths+=("$path")
done
if [ ! -s /etc/qwixbox/config.env ]; then
  echo "FAILED: encryption configuration is missing" >&2; fail=1
elif ! tar czf "$DEST/config.tar.gz" "${paths[@]}"; then
  echo "FAILED to archive configuration" >&2; fail=1
elif ! tar tzf "$DEST/config.tar.gz" | grep -x 'etc/qwixbox/config.env' >/dev/null; then
  echo "FAILED: encryption configuration is absent from archive" >&2; fail=1
fi

### The config archive contains database passwords and TLS keys.
chmod -R go-rwx "$DEST"

### Optional offsite copy.
if [ "$fail" -eq 0 ]; then touch "$DEST/COMPLETE"; fi
if [ "$fail" -eq 0 ] && [ -n "${OFFSITE_RSYNC_TARGET:-}" ]; then
  # Copy the verified snapshot before pruning local history. Do not mirror deletions offsite.
  rsync -az "$DEST" "$OFFSITE_RSYNC_TARGET/" \
    && echo "synced offsite" || { echo "offsite sync FAILED" >&2; fail=1; }
fi

if [ "$fail" -eq 0 ]; then
  find "$BACKUP_DIR" -maxdepth 1 -type d -name '20*' -mtime +"$KEEP_DAYS" -exec rm -rf {} +
  echo "backup $STAMP complete ($(du -sh "$DEST" | cut -f1))"
else
  echo "Backup failed - skipping retention prune" >&2
fi
exit $fail
