---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { TITLES, ORDER, blurb } from "../../lib/docs";

const entries = await getCollection("docs");
const sorted = entries.sort(
  (a, b) => (ORDER.indexOf(a.id) + 1 || 99) - (ORDER.indexOf(b.id) + 1 || 99),
);
---

<Base title="Docs — QwixBox" description="QwixBox documentation: status, roadmap, hardware testing and design notes.">
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Documentation</p>
      <h1>Docs</h1>
      <p class="intro">
        Rendered from the repository, so this is the same text a contributor reads. Design notes
        describe work that has not been built — they say so at the top.
      </p>
      <ul class="list">
        {sorted.map((e) => (
          <li>
            <a href={`/docs/${e.id}/`}>{TITLES[e.id] ?? e.id}</a>
            <span>{blurb(e.id)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    h1 { font-size: clamp(2rem, 5vw, 3rem); }
    .intro { color: var(--slate); max-width: var(--measure); margin: 1.25rem 0 2.5rem; }
    .list { list-style: none; padding: 0; margin: 0; }
    .list li { border-top: 1px solid var(--rule); padding: 1.1rem 0; display: grid; gap: 0.3rem; }
    .list li:last-child { border-bottom: 1px solid var(--rule); }
    .list a { font-family: var(--display); font-weight: 600; font-size: 1.1rem; text-decoration: none; }
    .list span { color: var(--slate); font-size: 0.92rem; }
  </style>
</Base>
