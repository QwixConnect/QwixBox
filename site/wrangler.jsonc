{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qwixbox-site",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, assets are served before the Worker ever runs and the hostname branch in
    // worker.ts is dead code - get.qwixbox.com would return the landing page.
    "run_worker_first": true
  },
  // Custom domains create and own their DNS records, so the zone must not already carry a
  // manually managed A or CNAME for these names (Cloudflare error 100117).
  "routes": [
    { "pattern": "qwixbox.com", "custom_domain": true },
    { "pattern": "www.qwixbox.com", "custom_domain": true },
    { "pattern": "get.qwixbox.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
