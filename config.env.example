# QwixBox site configuration.
#
# The installer reads /etc/qwixbox/config.env. On the first run it creates that file from
# this template and fills in generated passwords, so secrets survive re-runs. Edit the
# deployed copy, not this one.
#
#   sudo install -d -m 0750 /etc/qwixbox
#   sudo install -m 0600 config.env.example /etc/qwixbox/config.env
#   sudo editor /etc/qwixbox/config.env

### --- Roles ----------------------------------------------------------------------------
# Which components this machine runs. "all" is the all-in-one case and is simply the
# degenerate form where every role lands on one host and every address below is loopback.
#
# Split across machines by setting this per host and pointing the addresses at real hosts:
#   ROLES="db"            PostgreSQL + Redis
#   ROLES="sip"           Kamailio + rtpengine  (the only internet-facing role)
#   ROLES="media"         FreeSWITCH
#   ROLES="portal"        API + web portal + nginx
#   ROLES="media portal"  FreeSWITCH with a node-local API (recommended - see API_BASE_URL)
ROLES="all"

### --- Component addresses ----------------------------------------------------------------
# All loopback for the all-in-one. Change these when splitting roles across machines.
DB_HOST="127.0.0.1"
DB_PORT=5432
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
FS_HOST="127.0.0.1"
FS_ESL_HOST="127.0.0.1"
FS_ESL_PORT=8021
RTPENGINE_HOST="127.0.0.1"

# Where FreeSWITCH fetches its directory/dialplan/config from via mod_xml_curl. This sits on
# the call path for every registration and every call setup, and mod_xml_curl has NO cache -
# so on a split deployment run an API instance on each media node and keep this loopback,
# rather than putting a network hop and a load balancer in front of call setup.
API_BASE_URL="http://127.0.0.1:3000"

# CIDR the roles use to reach each other. Only consulted when roles are split; the firewall
# opens the internal service ports to this range and nothing else.
INTERNAL_CIDR="127.0.0.1/32"

### --- Identity -------------------------------------------------------------------------
# Public FQDN of this server. Must already resolve to its public IP: Let's Encrypt validates
# over HTTP, and SIP TLS certificates are issued for this name.
PBX_FQDN="pbx.example.com"

# SIP domain presented to endpoints. Often the same as PBX_FQDN.
PBX_SIP_DOMAIN="pbx.example.com"

# Address for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL="admin@example.com"

# Set to 1 to use the Let's Encrypt staging CA while testing, so you do not burn rate limits
# on a name that is not ready yet.
LETSENCRYPT_STAGING=0

### --- First portal account -----------------------------------------------------------
# Set these and 44-admin-account.sh creates the account and its tenant during the install, so a
# finished install is one you can sign in to. Leave ADMIN_EMAIL empty to skip the step and run
# create-user.ts / provision-tenant.ts by hand instead.
#
# The password is generated during the install and shown once - it is never read from here.
# There is deliberately no default credential.
ADMIN_EMAIL=""

# Display name for the account. Defaults to the part of ADMIN_EMAIL before the @.
ADMIN_NAME=""

# The customer this system belongs to. TENANT_NAME is what the portal shows; TENANT_SLUG is its
# handle in URLs and in add-tenant-user.ts, and is derived from the name when left empty.
TENANT_NAME=""
TENANT_SLUG=""

### --- DNS ------------------------------------------------------------------------------
# Who creates the A record for PBX_FQDN and the mail records in 15-mail.sh.
#
#   none           you create them yourself. The installer prints exactly what is needed.
#   domainconnect  your own DNS provider does it: you approve once in a browser and no
#                  credential is stored anywhere. Supported by GoDaddy, IONOS, Cloudflare,
#                  NameSilo, Plesk, Vercel and WordPress.com, detected automatically.
#                  Cannot renew a dns-01 certificate - it needs a person each time - so
#                  ACME_CHALLENGE stays "http" on this setting.
#   cloudflare     an API token below. The only option that works unattended, and therefore
#                  the only one that can use ACME_CHALLENGE="dns".
#   auto           domainconnect if the provider supports it, else cloudflare if a token is
#                  set, else none. What the wizard writes.
DNS_PROVIDER="none"

# Token from: My Profile > API Tokens > Create Token.
# Permissions: Zone:Read and DNS:Edit, restricted to the one zone. Nothing wider is needed.
CLOUDFLARE_API_TOKEN=""

# Usually left blank - it is looked up from PBX_FQDN. Set it only when the account can see
# several zones that could match the name.
CLOUDFLARE_ZONE_ID=""

# How Let's Encrypt proves you own the name.
#   http - the default. Needs port 80 reachable from the internet.
#   dns  - a TXT record via the DNS provider above. The only option when port 80 is closed,
#          and the only one that can issue a wildcard certificate.
ACME_CHALLENGE="http"

TIMEZONE="Etc/UTC"

# Where to report the end of an install run. Both optional; leave empty to stay silent. The
# FreeSWITCH build takes 10-20 minutes on 2 vCPU, so this is mostly for walking away from it.
# Email needs the mail relay (15-mail.sh) to be configured. A run that stops to ask for
# configuration is not reported - only a real success or failure.
INSTALL_NOTIFY_EMAIL=""
INSTALL_NOTIFY_WEBHOOK=""

# --- Outbound mail -------------------------------------------------------------------------
#
# Voicemail-to-email and fax-to-email deliver through this relay. Leave SMTP_HOST empty and
# both features still work - the recording is stored and downloadable from the portal - they
# just do not send anything.
#
# Use a transactional provider or your own relay, not a personal mailbox: this sends on behalf
# of every tenant, so SMTP_FROM must be an address you control and whose domain has SPF and
# DKIM set up. Sending as the caller's number, which is what stock FreeSWITCH does, gets the
# mail dropped by any receiver that checks alignment.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="pbx@example.com"
# "on" for STARTTLS on 587, "off" for implicit TLS on 465.
SMTP_STARTTLS="on"

# Display name on voicemail and fax notifications, and the address a user's reply goes to when
# the sender is not a real mailbox.
MAIL_FROM_NAME="Phone System"
MAIL_REPLY_TO=""

# Domain the outbound mail is signed as. Defaults to the domain part of SMTP_FROM, which is what
# receivers check DKIM alignment against - set it explicitly only if they should differ.
MAIL_DOMAIN=""

# DKIM selector. Appears in DNS as <selector>._domainkey.<MAIL_DOMAIN>. The key is generated once
# and never rotated automatically: replacing it breaks every signature until DNS catches up.
DKIM_SELECTOR="qwixbox"

# Publish an MX record for MAIL_DOMAIN pointing at this host. Off, and it should almost always
# stay off: nothing here accepts inbound mail, so an MX pointing at it makes every message sent
# to the domain bounce.
DNS_PUBLISH_MX=0

### --- Network --------------------------------------------------------------------------
# CIDRs allowed to reach SSH and the API. Space separated. "0.0.0.0/0" allows the world,
# which you almost certainly do not want for SSH.
ADMIN_ALLOW_CIDR="0.0.0.0/0"

# SIP signalling. Kamailio is the ONLY internet-facing SIP element - for endpoints and for
# carrier trunks alike. FreeSWITCH never talks to a carrier directly and never binds a public
# address; it listens on FS_INTERNAL_SIP_PORT behind Kamailio.
SIP_PORT=5060
SIPS_PORT=5061
FS_INTERNAL_SIP_PORT=5080

# Kamailio's egress listener - the port FreeSWITCH sends outbound calls back to, so Kamailio
# can select the trunk and (later) sign the call. Bound to the internal interface only, never
# exposed. Keeping it distinct from SIP_PORT is what makes the ingress and egress passes
# unambiguous, which matters because Kamailio sees every call twice.
KAM_EGRESS_PORT=5070

# RTP media range handled by rtpengine. Media is relayed on BOTH legs (endpoint<->FreeSWITCH
# and FreeSWITCH<->carrier), so budget ~4 ports per call, not 2. This is also what keeps
# FreeSWITCH's address off the wire entirely.
RTP_PORT_MIN=16384
RTP_PORT_MAX=32768

# SIP over secure WebSocket, for browser clients (the React portal softphone).
# Needs TLS, so 13-tls-certs.sh must have run. Separate port from SIPS so a browser and a
# hardware phone are not sharing a listener.
ENABLE_WEBRTC=1
WSS_PORT=8443

### --- Services ------------------------------------------------------------------------
PG_VERSION=18
API_PORT=3000
API_USER="qwixbox"
API_DIR="/opt/qwixbox-api"
WEB_ROOT="/var/www/qwixbox-portal"

# FreeSWITCH source tag to build.
FS_VERSION="v1.11.1"

# Sound rates to install. 8000 for G.711/PSTN, 48000 for Opus.
FS_SOUND_RATES="8000 48000"

### --- STIR/SHAKEN --------------------------------------------------------------------------
# Caller ID attestation, required by the FCC (US) and CRTC (Canada) for outbound PSTN.
# Off by default: it is a source build AND needs a certificate from an STI-CA, which means
# obtaining an OCN and an SPC token from the policy administrator first.
ENABLE_STIR_SHAKEN=0

# EC (prime256v1) signing key and the SP certificate issued with it.
STIR_SHAKEN_KEY="/etc/qwixbox/stir/signing.key"
STIR_SHAKEN_CERT="/etc/qwixbox/stir/signing.pem"

# Public HTTPS URL where the certificate above is published. Verifying carriers fetch it to
# check your signature, so it must be reachable from the internet.
STIR_SHAKEN_X5U=""

# Attestation level asserted on calls you originate:
#   A = you authenticated the caller and they own the number
#   B = you authenticated the caller but cannot confirm the number
#   C = the call came from elsewhere; you can only identify the gateway
# Claiming A for traffic you cannot vouch for is a compliance problem.
STIR_SHAKEN_ATTEST="B"

# Origination identifier (UUID) that ties signed calls back to you.
STIR_SHAKEN_ORIGID=""

### --- Fraud and abuse controls -----------------------------------------------------------
# Simultaneous calls allowed per account. The main defence against toll fraud: a stolen
# credential is monetised by placing many international calls at once, and a cap turns an
# overnight five-figure bill into a handful of calls plus an alert. Raise it for call
# centre accounts that genuinely need it.
MAX_CONCURRENT_CALLS=10

# Retention for call detail records, in days. Check what your jurisdiction requires before
# shortening this.
CDR_KEEP_DAYS=365
RECORDING_KEEP_DAYS=90

### --- Secrets --------------------------------------------------------------------------
# Left empty here on purpose. The installer generates strong values on first run and writes
# them back into /etc/qwixbox/config.env. Set them explicitly only if you are restoring an
# existing deployment and need specific values.
KAMAILIO_DB_PASSWORD=""
KAMAILIO_RO_DB_PASSWORD=""
API_DB_PASSWORD=""
FS_ESL_PASSWORD=""
RTPENGINE_NG_PORT=2223
